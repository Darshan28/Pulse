# PostgreSQL connection string (required in production / Vercel)
# Example Neon: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Prefer a pooled connection string in production.
DATABASE_URL=

# Force file-backed memory store (LOCAL PROTOTYPING ONLY)
# Forbidden on Vercel / NODE_ENV=production — the API will refuse to start.
USE_MEMORY_DB=true

# Upstash Redis (required on Vercel / production for multi-instance realtime)
REDIS_URL=
REDIS_TOKEN=

# Public app URL (join links, QR codes, auth redirects)
# Development: http://localhost:5173
# Preview:     https://your-preview.vercel.app  (set per Preview env in Vercel)
# Production:  https://your-app.vercel.app  OR  https://your-custom-domain.com
# No trailing slash. Never hard-code localhost into production env values.
VITE_APP_URL=http://localhost:5173

# Optional extra CORS origins (comma-separated). Localhost is auto-allowed in non-prod.
# Preview hosts also allow https://$VERCEL_URL automatically.
# CORS_ORIGINS=https://extra-origin.example.com

# ── Supabase Auth (presenter authentication) ───────────────────────────────
# Create a project at https://supabase.com
# Enable Google + Email (magic link) under Authentication → Providers
#
# Redirect allowlist (Authentication → URL Configuration) — controlled list only:
#   http://localhost:5173/auth/callback
#   https://YOUR_APP.vercel.app/auth/callback
#   https://YOUR_PREVIEW.vercel.app/auth/callback
#   https://your-custom-domain.com/auth/callback
#
# Browser-safe (safe to expose in the Vite build / Vercel env):
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
#
# Server-only JWT verification (same values OK; never put service role in VITE_*):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# NEVER expose the service role key to Vite / the browser:
# SUPABASE_SERVICE_ROLE_KEY=

# PostHog (optional — app works without these)
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Server
PORT=3001
COOKIE_SECURE=false
MAX_PARTICIPANTS_PER_SESSION=200

# Optional HMAC secret for localhost "Continue as test user" tokens.
# Only used when NODE_ENV is not production and not on Vercel.
# If unset, a local default is used. Never enable / rely on this in production.
# DEV_AUTH_SECRET=
